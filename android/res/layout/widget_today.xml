<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片样式 ③：今日课程清单（最多 4 条），4×2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/t_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_title"
            android:text="今天 · 周一" />

        <TextView
            android:id="@+id/t_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10.5sp"
            android:maxLines="1"
            android:textColor="@color/widget_dim"
            android:text="3 节课" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/widget_text"
        android:visibility="gone"
        android:text="今天没有课，好好休息 ☕" />

    <LinearLayout
        android:id="@+id/t_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/t_bar1"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_title"
                android:text="高等数学A" />

            <TextView
                android:id="@+id/t_meta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:text="08:00 – 09:40 · 信息楼305" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/t_bar2"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t_name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_title"
                android:text="线性代数" />

            <TextView
                android:id="@+id/t_meta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:text="10:00 – 11:40 · 信息楼208" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/t_bar3"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t_name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_title"
                android:text="大学物理B1" />

            <TextView
                android:id="@+id/t_meta3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:text="14:00 – 15:40 · 北区3号楼102" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_row4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/t_bar4"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t_name4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_title"
                android:text="大学英语" />

            <TextView
                android:id="@+id/t_meta4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:text="16:00 – 17:40 · 文科楼401" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
